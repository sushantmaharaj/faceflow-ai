# ============================================================
# FaceFlow AI — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

APP_ENV=development

# ── SerpApi ─────────────────────────────────────────────────
# Get your key at https://serpapi.com
SERPAPI_API_KEY=your_serpapi_key_here

# ── Alchemy / Ethereum Sepolia ───────────────────────────────
# Get your key at https://dashboard.alchemy.com
ALCHEMY_API_KEY=your_alchemy_api_key_here
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_api_key_here

# ── Blockchain wallet ────────────────────────────────────────
# Private key of a wallet that holds Sepolia test ETH.
# Use the Alchemy faucet: https://www.alchemy.com/faucets/ethereum-sepolia
# WARNING: Never use a wallet that holds real ETH.
BLOCKCHAIN_PRIVATE_KEY=0xyour_private_key_here

# ── Smart contract ───────────────────────────────────────────
# After deploying contracts/ContentRegistry.sol to Sepolia,
# paste the deployed contract address here.
CONTRACT_ADDRESS=0xyour_contract_address_here

# ── Chain configuration ──────────────────────────────────────
CHAIN_ID=11155111

# ── Face matching thresholds ─────────────────────────────────
# Cosine similarity range: 0.0 (no match) to 1.0 (identical)
FACE_MATCH_THRESHOLD=0.60
FACE_STRONG_MATCH_THRESHOLD=0.75

# ── Request limits ───────────────────────────────────────────
MAX_UPLOAD_MB=10
SEARCH_MAX_CANDIDATES=10
REQUEST_TIMEOUT_SECONDS=15

# ── InsightFace model ────────────────────────────────────────
# Automatically downloaded on first run to ~/.insightface/
INSIGHTFACE_MODEL_NAME=buffalo_l

# ── TMDB (The Movie Database) ────────────────────────────────
# Free API key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# ── Google Gemini AI ─────────────────────────────────────────
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
